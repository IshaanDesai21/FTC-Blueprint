        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Submit your code, CAD, or engineering portfolio and our team will give you detailed, actionable feedback - free for all FTC teams."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Envía tu código, CAD o portafolio de ingeniería y nuestro equipo te dará retroalimentación detallada y práctica, gratis para todos los equipos de FTC."
