    "Drag the sliders and watch how the robot responds to a fixed target of 100 units.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag the sliders and watch how the robot responds to a fixed target of 100 units."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra los controles deslizantes y observa cómo responde el robot a un objetivo fijo de 100 unidades."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्लाइडर्स को खींचें और देखें कि रोबोट 100 यूनिट के एक निश्चित लक्ष्य पर कैसे प्रतिक्रिया करता है."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste os controles deslizantes e veja como o robô responde a um alvo fixo de 100 unidades."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Trage glisoarele și urmărește cum reacționează robotul la o țintă fixă de 100 de unități."
          }
        }
      }
