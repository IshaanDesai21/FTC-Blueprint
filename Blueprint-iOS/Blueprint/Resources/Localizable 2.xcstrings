    "Preview 3D robot parts on your phone. Natively supports OBJ, Collada (DAE), USDZ, STL, and PLY.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Preview 3D robot parts on your phone. Natively supports OBJ, Collada (DAE), USDZ, STL, and PLY."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Previsualiza piezas 3D del robot en tu teléfono. Compatible de forma nativa con OBJ, Collada (DAE), USDZ, STL y PLY."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने फ़ोन पर 3D रोबोट पार्ट्स प्रीव्यू करें. मूल रूप से OBJ, Collada (DAE), USDZ, STL, और PLY को सपोर्ट करता है."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Visualize peças 3D do robô no seu celular. Suporta nativamente OBJ, Collada (DAE), USDZ, STL e PLY."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Previzualizează piese 3D ale robotului pe telefon. Suportă nativ OBJ, Collada (DAE), USDZ, STL și PLY."
          }
        }
      }
    },
