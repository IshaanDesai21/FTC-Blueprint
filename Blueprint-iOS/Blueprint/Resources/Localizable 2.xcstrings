    "Drag the robot away from the target, then let go. Tune the gains so it comes back quickly without overshooting.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag the robot away from the target, then let go. Tune the gains so it comes back quickly without overshooting."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra el robot lejos del objetivo y suéltalo. Ajusta las ganancias para que regrese rápido sin pasarse."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रोबोट को लक्ष्य से दूर खींचें, फिर छोड़ दें. गेन्स को ट्यून करें ताकि वह ओवरशूट किए बिना जल्दी वापस आ जाए."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste o robô para longe do alvo e solte. Ajuste os ganhos para que ele volte rapidamente sem ultrapassar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Trage robotul departe de țintă, apoi dă-i drumul. Reglează câștigurile ca să revină repede fără să depășească ținta."
          }
        }
      }
    },
    "Drag the robot, then let go": {
      "localizations": {
        "en": {
