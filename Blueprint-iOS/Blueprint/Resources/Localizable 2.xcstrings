    "Use the pad to strafe and translate, and the rotate buttons to spin. Watch the wheel powers update live.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the pad to strafe and translate, and the rotate buttons to spin. Watch the wheel powers update live."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa el panel para desplazarte lateralmente y trasladarte, y los botones de rotación para girar. Observa cómo se actualiza la potencia de las ruedas en vivo."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्ट्राफ़ और ट्रांसलेट करने के लिए पैड का उपयोग करें, और घूमने के लिए रोटेट बटन का. व्हील पावर को लाइव अपडेट होते देखें."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Use o pad para deslocar-se lateralmente e transladar, e os botões de rotação para girar. Veja a potência das rodas atualizar em tempo real."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Folosește panoul pentru deplasare laterală și translație, iar butoanele de rotație pentru a te roti. Urmărește puterea roților actualizându-se live."
          }
        }
      }
    },
