    "Shape acceleration and deceleration so your drivetrain moves smoothly instead of slamming full power.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shape acceleration and deceleration so your drivetrain moves smoothly instead of slamming full power."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Da forma a la aceleración y desaceleración para que tu tren motriz se mueva suavemente en lugar de aplicar potencia máxima de golpe."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "त्वरण और मंदन को आकार दें ताकि आपका ड्राइवट्रेन अचानक पूरी शक्ति लगाने के बजाय सहजता से चले."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Molde a aceleração e desaceleração para que seu trem de força se mova suavemente em vez de aplicar potência total de repente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Modelează accelerația și decelerația pentru ca transmisia ta să se miște lin, nu cu putere maximă bruscă."
          }
        }
      }
    },
    "Share your CAD and we'll provide feedback on design, manufacturability, and weight.": {
