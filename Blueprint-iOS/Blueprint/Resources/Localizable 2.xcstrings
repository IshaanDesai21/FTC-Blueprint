    "Blueprint also respects your device's system Dynamic Type, Bold Text, and Reduce Motion settings in Settings > Accessibility.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Blueprint also respects your device's system Dynamic Type, Bold Text, and Reduce Motion settings in Settings > Accessibility."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Blueprint también respeta la configuración de Tipo Dinámico, Texto en Negrita y Reducir Movimiento de tu dispositivo en Ajustes > Accesibilidad."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Blueprint आपके डिवाइस की सिस्टम Dynamic Type, Bold Text और Reduce Motion सेटिंग्स को भी Settings > Accessibility में मानता है."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Blueprint também respeita as configurações de Tipo Dinâmico, Texto em Negrito e Reduzir Movimento do seu dispositivo em Ajustes > Acessibilidade."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Blueprint respectă, de asemenea, setările sistemului tău pentru Tip Dinamic, Text Îngroșat și Reduce Mișcarea din Setări > Accesibilitate."
          }
        }
      }
    },
